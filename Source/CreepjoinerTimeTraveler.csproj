<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CreepjoinerTimeTraveler</AssemblyName>
    <RootNamespace>CreepjoinerTimeTraveler</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    Reference assemblies via NuGet:
      - Krafs.Rimworld.Ref:  RimWorld + Unity refs (all DLCs including Anomaly bundled)
      - Lib.Harmony:         0Harmony.dll (ExcludeAssets=runtime, because Harmony is loaded separately as a mod)

    NuGet required. Build via:   dotnet build -c Release
  -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.3.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
